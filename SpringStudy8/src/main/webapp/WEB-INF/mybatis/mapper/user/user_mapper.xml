<?xml version="1.0" encoding="UTF-8"?> 
<!DOCTYPE mapper PUBLIC
		   "-//mybatis.org//DTD Mapper 3.0//EN" 
		   "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
		   
<mapper namespace="user_mapper">

<insert id="saveUser" parameterType="User">
		INSERT INTO T_USER
		VALUES(
			#{id},
			#{pw},
			#{name},	
			#{userType}	
		)
	</insert>
	
	<select id="findUserList" resultType="User">
		select * from T_User
	</select>
	
	<select id="findUserById" resultType="User" parameterType="String">
		select * from T_User
		where id = #{id}
	</select>
	
	<select id="checkUserLogin" resultType="User" parameterType="User">
		select * from T_User
		where id = #{id}
		and pw= #{pw}
		and user_type = #{userType}
	</select>
	
	<update id="modifyUser" parameterType="User">
		UPDATE T_USER
		SET pw = #{pw},
			name = #{name},
			user_type = #{userType}
		WHERE id = #{id}
	</update>
	
	<update id="modifyUserPw" parameterType="User">
		UPDATE T_USER
		SET pw = #{pw}
		WHERE id = #{id}
	</update>
	
	<select id="findUserListBySearchCondition" parameterType="UserSearchCondition" resultType="User">

		select *
		from T_USER
		<where>
			<trim prefixOverrides="OR" prefix="(" suffix=")">
				<if test="name != null and name != '' ">
					name LIKE '%' || #{searchKeyword} || '%'
				</if>
				<if test="name != null and name != '' ">
					OR id LIKE '%' || #{searchKeyword} || '%'
			</if>
			</trim>
			<if test="userType != null and userType != '' ">
				AND user_type = #{userType}
			</if>
		</where>
		
