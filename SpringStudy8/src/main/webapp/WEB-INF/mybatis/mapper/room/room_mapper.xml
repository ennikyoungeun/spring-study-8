<?xml version="1.0" encoding="UTF-8"?> 
<!DOCTYPE mapper PUBLIC
		   "-//mybatis.org//DTD Mapper 3.0//EN" 
		   "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
		   
<mapper namespace="room_mapper">
	
	<!-- <insert id="saveRoom" parameterType="com.app.dto.room.Room"> -->
	<insert id="saveRoom" parameterType="Room">
		INSERT INTO T_ROOM
		VALUES(
			SEQ_T_ROOM_PK.nextval,
			#{buildingName},
			#{roomNumber},
			#{floor},	
			#{maxGuestCount},
			#{viewType}	
		)
	</insert>
	
	<select id="findRoomList" resultType="Room">
		select * 
		from T_ROOM
		order by room_id
	</select>
	
	<select id="findRoomByRoomId" resultType="Room" parameterType="int">
		SELECT *
		FROM T_ROOM
		WHERE ROOM_ID = #{roomId}
	</select>
	
	<delete id="removeRoom" parameterType="int" >
		DELETE FROM T_ROOM
		WHERE room_id = #{roomId}
	</delete>
	
	
	<update id="modifyRoom" parameterType="Room">
		UPDATE T_ROOM
		SET
			building_name = #{buildingName},
			room_number = #{roomNumber},
			floor = #{floor},
			max_guest_count = #{maxGuestCount},
			view_type = #{viewType}
		WHERE ROOM_ID = #{roomId}
	</update>
	

   <select id="findRoomListBySearchCondition" parameterType="RoomSearchCondition" resultType="Room">
      SELECT 
          room_id,
          building_name,
          room_number,
          floor,
          max_guest_count,
          view_type
      FROM T_ROOM
      <where>
      
         <if test="buildingName != null and buildingName != ''">
            building_name LIKE '%' || #{buildingName} || '%'
         </if>
         
         <if test="viewType != null and viewType != ''">
            AND view_type = #{viewType}
         </if>
      </where>
  
   </select>

</mapper>